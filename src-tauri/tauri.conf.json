{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plumb",
  "version": "0.1.1",
  "identifier": "com.lubobill1990.plumb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plumb",
        "width": 1200,
        "height": 760,
        "minWidth": 400,
        "minHeight": 240,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
