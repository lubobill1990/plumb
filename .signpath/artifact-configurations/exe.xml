<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "exe": the app binary (plumb.exe, after Tauri's
     bundler patched in the bundle type), uploaded as a GitHub Actions artifact (a zip).
     Paste into SignPath: Project > Artifact configurations > "exe". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="plumb.exe" product-name="Plumb" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
